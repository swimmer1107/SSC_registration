generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sport {
  id              String          @id @default(cuid())
  name            String          @unique
  category        String          // "team" or "individual"
  minTeamSize     Int?
  maxTeamSize     Int?
  registrationFee Int
  isActive        Boolean         @default(true)
  description     String?
  rules           String?
  createdAt       DateTime        @default(now())
  liveScores      LiveScore[]
  results         Result[]
  councilMembers  CouncilMember[]
  eventSports     EventSport[]
  fixtures        Fixture[]
  registrations   Registration[]

  @@map("sports")
}

model Event {
  id               String       @id @default(cuid())
  
  // Existing fields
  title            String
  description      String
  startDate        DateTime?
  endDate          DateTime?
  venue            String?
  bannerImageUrl   String?
  status           String       @default("upcoming")
  academicYear     String       @default("2025-26")
  registrationOpen Boolean      @default(true)
  
  // New Tournament Details
  icon             String?
  category         String       @default("tournament")
  sport            String?
  prizePool        Int?
  capacity         String?
  ctaText          String?
  ctaLink          String?
  gradient         String?
  isActive         Boolean      @default(true)
  order            Int          @default(0)
  
  // Meta
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  
  // Relations
  results          Result[]
  eventSports      EventSport[]

  @@map("events")
}

model EventSport {
  id                   String    @id @default(cuid())
  eventId              String
  sportId              String
  price                Float     @default(0)
  registrationDeadline DateTime?
  isExpired            Boolean   @default(false)
  maxSlots             Int?
  currentSlots         Int       @default(0)
  slotType             String    @default("individual")
  sport                Sport     @relation(fields: [sportId], references: [id])
  event                Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sportId])
  @@map("event_sports")
}

model Student {
  id                 String         @id @default(cuid())
  fullName           String
  email              String         @unique
  phone              String?
  college            String
  course             String
  year               String
  registrationNumber String?
  gender             String?
  dateOfBirth        DateTime?
  address            String?
  createdAt          DateTime       @default(now())
  registrations      Registration[]
  registrationMembers RegistrationMember[]

  @@map("students")
}

model Registration {
  id                     String       @id @default(cuid())
  registrationId         String       @unique
  studentId              String
  sportId                String
  isTeamEvent            Boolean      @default(false)
  teamName               String?
  paymentAmount          Int
  paymentScreenshot      String?
  transactionId          String?
  paymentStatus          String       @default("pending")
  status                 String       @default("pending")
  rejectionReason        String?
  registeredAt           DateTime     @default(now())
  approvedAt             DateTime?
  fixturesAsParticipant2 Fixture[]    @relation("Participant2")
  fixturesAsParticipant1 Fixture[]    @relation("Participant1")
  sport                  Sport        @relation(fields: [sportId], references: [id])
  student                Student      @relation(fields: [studentId], references: [id])
  registrationMembers RegistrationMember[]

  @@map("registrations")
}

model RegistrationMember {
  id             String       @id @default(cuid())
  registrationId String
  studentId      String
  role           String?
  student        Student      @relation(fields: [studentId], references: [id])
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("registration_members")
}

model CouncilMember {
  id           String  @id @default(cuid())
  fullName     String
  role         String
  designation  String?
  department   String?
  photoUrl     String?
  sportId      String?
  instagram    String?
  linkedin     String?
  email        String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  sport        Sport?  @relation(fields: [sportId], references: [id])

  @@map("council_members")
}

model Fixture {
  id               String        @id @default(cuid())
  fixtureNumber    String        @unique
  sportId          String
  stage            String
  matchType        String
  participant1Id   String?
  participant1Name String
  participant2Id   String?
  participant2Name String
  scheduledDate    DateTime?
  scheduledTime    String?
  venue            String?
  score1           String?
  score2           String?
  winnerId         String?
  status           String        @default("scheduled")
  nextFixtureId    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  liveScore        LiveScore?
  nextFixture      Fixture?      @relation("NextFixture", fields: [nextFixtureId], references: [id])
  previousMatches  Fixture[]     @relation("NextFixture")
  participant2     Registration? @relation("Participant2", fields: [participant2Id], references: [id])
  participant1     Registration? @relation("Participant1", fields: [participant1Id], references: [id])
  sport            Sport         @relation(fields: [sportId], references: [id])

  @@map("fixtures")
}

model LiveScore {
  id        String   @id @default(cuid())
  fixtureId String   @unique
  sportId   String
  teamA     String
  teamB     String
  scoreA    String   @default("0")
  scoreB    String   @default("0")
  status    String   @default("upcoming")
  venue     String?
  details   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  sport     Sport    @relation(fields: [sportId], references: [id])
  fixture   Fixture  @relation(fields: [fixtureId], references: [id])
}

model Result {
  id         String   @id @default(cuid())
  eventId    String
  sportId    String
  position   Int
  winnerName String
  certUrl    String?
  awardedAt  DateTime @default(now())
  sport      Sport    @relation(fields: [sportId], references: [id])
  event      Event    @relation(fields: [eventId], references: [id])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("MODERATOR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model GalleryPhoto {
  id           String   @id @default(cuid())
  url          String
  category     String
  sportTag     String?
  eventTag     String?
  displayOrder Int      @default(0)
  uploadedAt   DateTime @default(now())
}

// Removed old Notice model to avoid conflict with new one

model Sponsor {
  id           String @id @default(cuid())
  name         String
  logoUrl      String
  tier         String @default("main")
  displayOrder Int    @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  message   String
  status    String   @default("unread") // "unread", "read", "replied"
  sentAt    DateTime @default(now())
  
  @@map("contact_messages")
}

model FestEvent {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String
  category    String
  ctaText     String
  ctaLink     String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("fest_events")
}

model OtpCode {
  id        String   @id @default(cuid())
  contact   String
  method    String   @default("phone")
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id          String   @id @default(cuid())
  title       String?
  description String?
  imageUrl    String   // Path to uploaded image
  category    String   // "sports", "cultural", "events", "workshops"
  event       String?  // Event name (e.g., "Cricket Finals 2025")
  uploadedBy  String   // Admin email
  isActive    Boolean  @default(true)
  order       Int      @default(0) // Display order
  createdAt   DateTime @default(now())
  
  @@map("gallery_images")
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String   // "President", "Vice President", "Sports Secretary", etc.
  type        String   // "council" or "captain"
  sport       String?  // Only for captains - "Cricket", "Football", etc.
  imageUrl    String   // Profile photo path
  email       String?
  phone       String?
  bio         String?  // Short description
  year        String?  // "3rd Year", "4th Year"
  course      String?  // "B.Tech CSE"
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  @@map("team_members")
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  message     String   @db.Text
  category    String
  priority    String   @default("normal")
  sendEmail   Boolean  @default(false)
  emailSentTo Int      @default(0)
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  
  @@map("notices")
}

